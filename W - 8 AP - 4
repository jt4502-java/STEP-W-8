import java.util.Scanner;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = Integer.parseInt(sc.nextLine().trim());
        double total = 0;

        Pattern quoted = Pattern.compile("\"([^\"]*)\"");

        for (int i = 0; i < n; i++) {
            String line = sc.nextLine().trim();
            int firstQuote = line.indexOf('"');
            String type = line.substring(0, firstQuote).trim()
                    .toUpperCase();

            Matcher matcher = quoted.matcher(line);
            String[] fields = new String[3];
            int count = 0;

            while (matcher.find() && count < 3) {
                fields[count++] = matcher.group(1);
            }

            String question = fields[0];
            String correct = fields[1];
            String student = fields[2];

            String remaining = line.substring(
                    line.lastIndexOf('"') + 1).trim();
            double points = Double.parseDouble(remaining);

            double score = 0;

            if (type.equals("MCQ") || type.equals("TF")) {
                if (student.equals(correct)) {
                    score = points;
                }
            } else if (type.equals("ESSAY")) {
                String[] keywords = correct.split(",");
                int matches = 0;

                for (String keyword : keywords) {
                    if (student.toLowerCase().contains(
                            keyword.trim().toLowerCase())) {
                        matches++;
                    }
                }

                if (matches >= 2) {
                    score = points * 0.75;
                } else if (matches == 1) {
                    score = points * 0.50;
                }
            }

            System.out.printf("%s: %.2f%n", type, score);
            total += score;
        }

        System.out.printf("Total Score: %.2f%n", total);
        sc.close();
    }
}
